PORT=3000
NODE_ENV=development

# Wall clock the whole platform operates on. Every server-side "today"
# boundary, opening-hours check, time-slot generation and printed timestamp
# uses it, and the DB session is aligned to it so daily reports bucket by the
# merchant's day rather than UTC's. Defaults to Africa/Lagos.
APP_TIMEZONE=Africa/Lagos

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=mrjollof_db
DB_SYNC=true
DB_LOGGING=false

# Admin JWT (merchant hub) — use strong 32+ char secrets
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Staff JWT (workstation) — MUST differ from admin secrets
JWT_STAFF_SECRET=
JWT_STAFF_EXPIRES_IN=12h

ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082

BCRYPT_SALT_ROUNDS=10

# Google OAuth client ID used to verify storefront "Continue with Google" ID tokens.
# Must match the VITE_GOOGLE_CLIENT_ID configured in the storefront.
GOOGLE_CLIENT_ID=

# Key used to encrypt stored secrets at rest (merchant payment-provider API
# keys). Use a long random string. Falls back to JWT_SECRET if unset; set a
# dedicated value in production. NOTE: changing it makes existing stored
# provider secrets undecryptable (merchants must re-enter their keys).
CREDENTIALS_ENCRYPTION_KEY=

# ─── Redis (BullMQ job queues) ──────────────────────────────────────
# Required: the backend opens a Redis connection on boot for background job
# queues (currently payout processing). Without a reachable Redis you'll see
# repeated "ECONNREFUSED 6379" errors. Defaults to localhost:6379 if unset.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to true only if your managed Redis requires TLS.
REDIS_TLS=false

# ─── Custom domains ─────────────────────────────────────────────────
# Hostname merchants point their custom domain's CNAME at — the public
# storefront ingress. Returned in the DNS instructions when a merchant
# registers a domain (POST /domains). Set this to the actual storefront
# ingress host for this environment. Defaults to app.mrjollof.com.
DOMAIN_CNAME_TARGET=app.mrjollof.com

# First-run seeder. Runs once on boot if there are zero admins.
# Set SEED_ON_BOOT=false to disable.
SEED_ON_BOOT=true
SEED_BUSINESS_NAME=Mr. Jollof
SEED_STORE_NAME=Main Store
SEED_STORE_ADDRESS=1 Main Street, Lagos
SEED_STORE_PHONE=+2348000000000
SEED_STORE_EMAIL=main@mrjollof.com
SEED_ADMIN_NAME=Owner
SEED_ADMIN_EMAIL=owner@mrjollof.com
# IMPORTANT: change this for any non-dev deployment.
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---------------------------------------------------------------------------
# File storage. Pick ONE backend; STORAGE_DRIVER defaults to `cloudinary` when
# CLOUDINARY_CLOUD_NAME is set, otherwise `s3`.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=cloudinary

# Cloudinary (free tier, no card required). Values are on the dashboard home
# under "Product Environment Credentials".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Delivery transformation for raster images. Blank = serve original bytes.
CLOUDINARY_DELIVERY_TRANSFORM=f_auto,q_auto

# Cloudflare R2 / AWS S3 / MinIO (S3-compatible). Only used when STORAGE_DRIVER=s3.
# Endpoint: https://<account-id>.r2.cloudflarestorage.com (no bucket suffix).
S3_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=mrjollof-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL base (no trailing slash). Use the R2.dev public URL or a custom domain
# bound to the bucket. Bucket must be marked public via the R2 dashboard.
#   R2 dev:        https://pub-<hash>.r2.dev
#   Custom domain: https://files.mrjollof.com
S3_PUBLIC_URL_BASE=
# R2 requires path-style URLs.
S3_FORCE_PATH_STYLE=true

# ─── SMS / phone OTP (storefront) ───────────────────────────────────
# Provider selector for the storefront phone-auth flow.
#   console — log OTP to stdout (dev only; refuses to run in production
#             unless SMS_ALLOW_CONSOLE=1 is also set).
#   termii  — send via Termii (https://termii.com). Requires the keys below.
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=MrJollof
# TERMII_API_URL=https://v3.api.termii.com

# ─── Web push (storefront PWA) ──────────────────────────────────────
# Generate once with:  npx web-push generate-vapid-keys
# Without these set, /notifications/web-push/public-key returns null and
# PushService.sendToCustomer is a no-op (graceful degradation).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@mrjollof.com
